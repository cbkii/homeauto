[Unit]
Description=homeauto optional bounded MQTT action bridge
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=homeauto-actions
Group=homeauto-actions
WorkingDirectory=/var/lib/homeauto-actions
EnvironmentFile=-/etc/homeauto/actions.env
Environment=HOME=/var/lib/homeauto-actions
ExecStart=/usr/bin/python3 /opt/homeauto/scripts/ha-action-bridge/bridge.py --config /etc/homeauto/actions.json
Restart=on-failure
RestartSec=10s
TimeoutStartSec=30s
TimeoutStopSec=35s
StateDirectory=homeauto-actions
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homeauto-actions
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
