# Timezone passed to containers.
TZ=Etc/UTC

# Stable coordinator path from /dev/serial/by-id/*
ZIGBEE_DEVICE=/dev/serial/by-id/replace-with-your-zigbee-adapter

# MQTT credentials used to generate mosquitto/config/passwd
MQTT_USER=ha
MQTT_PASS=replace_with_strong_password

# MariaDB credentials used by Home Assistant recorder and optional app storage
MARIADB_ROOT_PASSWORD=replace_with_strong_root_password
MARIADB_DATABASE=homeauto
MARIADB_USER=homeauto
MARIADB_PASSWORD=replace_with_strong_db_password

# Optional defaults for helper scripts (overridden by MQTT payload values at runtime)
ANDROID_TV_IP=192.168.1.60
BT_DEVICE_MAC=AA:BB:CC:DD:EE:FF
BT_PAIR_PIN=
