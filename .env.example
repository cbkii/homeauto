# Public settings only. Installer generates credentials outside the checkout.
TZ=Australia/Sydney
HOMEAUTO_DATA_DIR=/srv/homeauto
MQTT_BIND_ADDRESS=127.0.0.1
ZIGBEE_DEVICE=/dev/serial/by-id/SELECT_YOUR_COORDINATOR
# The installer writes the deployment .env. Supply ember/zstack with
# --zigbee-adapter during preparation, after confirming the radio (docs/ZIGBEE.md).
