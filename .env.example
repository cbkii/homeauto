# Timezone passed to containers.
TZ=Etc/UTC

# Stable coordinator path from /dev/serial/by-id/*
ZIGBEE_DEVICE=/dev/serial/by-id/replace-with-your-zigbee-adapter

# MQTT credentials used to generate mosquitto/config/passwd
MQTT_USER=ha
MQTT_PASS=replace_with_strong_password

# Optional defaults for helper scripts (can be overridden by HA shell_command envs)
ANDROID_TV_IP=192.168.1.60
BT_DEVICE_MAC=AA:BB:CC:DD:EE:FF
BT_PAIR_PIN=
